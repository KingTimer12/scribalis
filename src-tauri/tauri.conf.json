{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scribalis",
  "version": "0.1.2",
  "identifier": "Scribalis",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/Scribalis/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMTkxQjg1M0E2NkU5RTAKUldUZzZXWTZoUnNaU3JMeFBlaGUwWU4wVktpejJvZ3BoL2hmY3phZ2xYQzJGL3R1RVgyL3NabUUK",
      "endpoints": [
        "https://github.com/KingTimer12/scribalis/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
